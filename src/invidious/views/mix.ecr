<% encoded_id = URI.encode_www_form(mix.id) %>
<% content_for "header" do %>
<title><%= HTML.escape(mix.title) %> - Invidious</title>
<link rel="stylesheet" href="/css/playlist-pages.css?v=<%= ASSET_COMMIT %>">
<link rel="stylesheet" href="/css/mix-page.css?v=<%= ASSET_COMMIT %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed/playlist/<%= encoded_id %>">
<% end %>

<main class="playlist-page mix-page" aria-labelledby="mix-title">
    <header class="playlist-panel playlist-detail-top">
        <div class="playlist-identity">
            <span class="playlist-emblem" aria-hidden="true"><i class="icon ion-ios-musical-notes"></i></span>
            <div>
                <h1 id="mix-title" dir="auto"><%= HTML.escape(mix.title) %></h1>
                <div class="playlist-meta">
                    <span><%= I18n.translate_count(locale, "generic_videos_count", mix.videos.size, I18n::NumberFormatting::Separator) %></span>
                </div>
            </div>
        </div>
        <div class="playlist-actions">
            <% if first = mix.videos.first? %>
                <a class="playlist-primary" href="/watch?v=<%= URI.encode_www_form(first.id) %>&amp;list=<%= encoded_id %>">
                    <i class="icon ion-ios-play" aria-hidden="true"></i> <%= I18n.translate(locale, "mix_play") %>
                </a>
            <% end %>
            <a href="/feed/playlist/<%= encoded_id %>"><i class="icon ion-logo-rss" aria-hidden="true"></i> <%= I18n.translate(locale, "generic_button_rss") %></a>
        </div>
    </header>

    <% if mix.videos.empty? %>
        <p class="playlist-empty"><%= I18n.translate(locale, "playlist_page_empty") %></p>
    <% else %>
        <div class="playlist-panel mix-panel">
            <%= template_mix_queue(mix, continuation, locale, thin_mode: preferences.thin_mode) %>
        </div>
    <% end %>
</main>
