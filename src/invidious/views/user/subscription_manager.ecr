<% content_for "header" do %>
<title><%= I18n.translate(locale, "Subscription manager") %> - Invidious</title>
<link rel="stylesheet" href="/css/subscriptions-page.css?v=<%= ASSET_COMMIT %>">
<link rel="stylesheet" href="/css/subscription-filter.css?v=<%= ASSET_COMMIT %>">
<script defer src="/js/subscription-filter.js?v=<%= ASSET_COMMIT %>"></script>
<% end %>

<%
    csrf_token = HTML.escape(env.get?("csrf_token").try &.as(String) || "")
    filter_hide_shorts = user.preferences.hide_shorts
    filter_referer = "%2Fsubscription_manager"
    filter_on_channel = false
    subscribed = true
%>

<main class="subscriptions-page" aria-labelledby="subscription-manager-title">
    <div class="subscriptions-heading">
        <div>
            <h1 id="subscription-manager-title"><%= I18n.translate(locale, "Subscription manager") %></h1>
            <p><%= I18n.translate_count(locale, "generic_subscriptions_count", subscriptions.size, I18n::NumberFormatting::Separator) %></p>
        </div>
        <div class="subscriptions-links">
            <a href="/feed/subscriptions"><i class="icon ion-ios-albums" aria-hidden="true"></i> <%= I18n.translate(locale, "Subscriptions") %></a>
            <a href="/feed/history"><i class="icon ion-ios-time" aria-hidden="true"></i> <%= I18n.translate(locale, "Watch history") %></a>
            <a href="/data_control?referer=<%= URI.encode_www_form(referer) %>"><i class="icon ion-ios-swap" aria-hidden="true"></i> <%= I18n.translate(locale, "Import/export") %></a>
        </div>
    </div>

    <% if subscriptions.empty? %>
        <p class="subscriptions-empty"><%= I18n.translate(locale, "subscription_manager_no_channels") %></p>
    <% else %>
        <div class="subscriptions-search" id="subscription-search-box" hidden>
            <i class="icon ion-ios-search" aria-hidden="true"></i>
            <input type="search" id="subscription-search" autocomplete="off"
                   placeholder="<%= HTML.escape(I18n.translate(locale, "subscription_manager_search")) %>"
                   aria-label="<%= HTML.escape(I18n.translate(locale, "subscription_manager_search")) %>"
                   aria-controls="subscription-list">
        </div>
        <p id="subscription-no-matches" class="subscriptions-empty" role="status" hidden><%= I18n.translate(locale, "subscription_manager_no_matches") %></p>

        <ul class="subscription-list" id="subscription-list">
            <% subscriptions.each do |channel| %>
                <%
                    filter_channel_id = channel.id
                    types = filters[channel.id]?
                    filter_types = types
                    selected = types || (user.preferences.hide_shorts ? "vl" : "vsl")
                    hide_members = types.try(&.includes?(Invidious::Database::SubscriptionFilters::HIDE_MEMBERS)) == true
                    labels = Invidious::Database::SubscriptionFilters::OPTIONS.select { |_, code| selected.includes?(code) }.map { |name, _|
                        I18n.translate(locale, "subscription_filter_#{name}")
                    }
                    summary = if types.nil?
                        I18n.translate(locale, "subscription_filter_inherit")
                    else
                        labels << I18n.translate(locale, "subscription_filter_empty") if labels.empty?
                        labels << I18n.translate(locale, "subscription_filter_members_hidden") if hide_members
                        labels.join(", ")
                    end
                %>
                <li class="subscription-card" data-subscription-filter-scope>
                    <a class="subscription-identity" href="/channel/<%= channel.id %>">
                        <span class="subscription-avatar" aria-hidden="true">
                            <%= HTML.escape(channel.author.strip[0, 1].upcase) %>
                            <% unless channel.deleted %>
                                <img src="/channel/<%= channel.id %>/avatar" alt="" width="48" height="48" loading="lazy" decoding="async">
                            <% end %>
                        </span>
                        <span>
                            <strong class="subscription-name"><%= HTML.escape(channel.author) %></strong>
                            <span class="subscription-status<%= " subscription-status-custom" if types %>"><%= summary %></span>
                        </span>
                    </a>

                    <%= rendered "components/subscription_filter" %>

                    <form class="subscription-remove" method="post" action="/subscription_ajax?action=remove_subscriptions&amp;c=<%= channel.id %>&amp;referer=%2Fsubscription_manager">
                        <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                        <button type="submit"><%= I18n.translate(locale, "unsubscribe") %></button>
                    </form>
                </li>
            <% end %>
        </ul>
        <script defer src="/js/subscription-manager.js?v=<%= ASSET_COMMIT %>"></script>
    <% end %>
</main>
