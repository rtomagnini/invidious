<%-
  ucid = channel.ucid
  author = HTML.escape(channel.author)
  channel_profile_pic = URI.parse(channel.author_thumbnail).request_target

  relative_url = "/channel/#{ucid}/community"
  youtube_url = "https://www.youtube.com#{relative_url}"
  redirect_url = Invidious::Frontend::Misc.redirect_url(env)

  selected_tab = Invidious::Frontend::ChannelPage::TabsAvailable::Posts
-%>

<% content_for "header" do %>
<link rel="alternate" href="<%= youtube_url %>">
<title><%= author %> - Invidious</title>
<link rel="stylesheet" href="/css/channel-page.css?v=<%= ASSET_COMMIT %>">
<link rel="stylesheet" href="/css/community-page.css?v=<%= ASSET_COMMIT %>">
<% end %>

<%= rendered "components/channel_info" %>

<section class="community-page" aria-label="<%= HTML.escape(I18n.translate(locale, "channel_tab_posts_label")) %>">
    <% if error_message %>
        <p class="community-panel"><%= error_message %></p>
    <% else %>
        <div class="community-feed" id="comments">
            <%= IV::Frontend::Comments.template_youtube(items.not_nil!, locale, thin_mode) %>
        </div>
    <% end %>
</section>

<script id="community_data" type="application/json">
<%=
{
    "ucid" => ucid,
    "youtube_comments_text" => HTML.escape(I18n.translate(locale, "View YouTube comments")),
    "comments_text" => HTML.escape(I18n.translate(locale, "View `x` comments", "{commentCount}")),
    "hide_replies_text" => HTML.escape(I18n.translate(locale, "Hide replies")),
    "show_replies_text" => HTML.escape(I18n.translate(locale, "Show replies")),
    "preferences" => env.get("preferences").as(Preferences)
}.to_pretty_json
%>
</script>
<script src="/js/community.js?v=<%= ASSET_COMMIT %>"></script>
