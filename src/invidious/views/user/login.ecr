<% content_for "header" do %>
<title><%= I18n.translate(locale, "Log in") %> - Invidious</title>
<link rel="stylesheet" href="/css/account.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="account-page account-narrow" aria-labelledby="account-title">
    <div class="account-panel">
        <% login_title = captcha ? "Register" : "Log in" %>
        <div class="account-heading">
            <span class="account-icon" aria-hidden="true"><i class="icon ion-ios-log-in"></i></span>
            <h1 id="account-title"><%= I18n.translate(locale, login_title) %></h1>
        </div>
        <form class="account-form" action="/login?referer=<%= URI.encode_www_form(referer) %>&amp;type=invidious" method="post">
            <% if email %>
                <input name="email" type="hidden" value="<%= HTML.escape(email) %>">
            <% else %>
                <label class="account-field" for="email">
                    <%= I18n.translate(locale, "User ID") %>
                    <input required id="email" name="email" type="text" autocomplete="username" autocapitalize="none" spellcheck="false">
                </label>
            <% end %>

            <% if password %>
                <input name="password" type="hidden" value="<%= HTML.escape(password) %>">
            <% else %>
                <label class="account-field" for="password">
                    <%= I18n.translate(locale, "Password") %>
                    <input required id="password" name="password" type="password" autocomplete="current-password">
                </label>
            <% end %>

            <% if captcha %>
                <img class="account-captcha" src="<%= captcha[:question] %>" alt="<%= I18n.translate(locale, "account_captcha_clock") %>">
                <% captcha[:tokens].each_with_index do |token, i| %>
                    <input type="hidden" name="token[<%= i %>]" value="<%= HTML.escape(token) %>">
                <% end %>
                <label class="account-field" for="answer">
                    <%= I18n.translate(locale, "Time (h:mm:ss):") %>
                    <input required id="answer" name="answer" type="text" placeholder="h:mm:ss">
                </label>
            <% end %>

            <button type="submit" name="action" value="signin" class="account-button account-primary">
                <% if captcha %>
                    <%= I18n.translate(locale, "Register") %>
                <% elsif CONFIG.registration_enabled %>
                    <%= I18n.translate(locale, "Sign In") %> / <%= I18n.translate(locale, "Register") %>
                <% else %>
                    <%= I18n.translate(locale, "Sign In") %>
                <% end %>
            </button>
        </form>
    </div>
</main>
