<%
    title = HTML.escape(playlist.title)
    author = HTML.escape(playlist.author)
    owns_playlist = playlist.is_a?(InvidiousPlaylist) && playlist.author == user.try &.email
    encoded_id = URI.encode_www_form(plid)
%>

<% content_for "header" do %>
<title><%= title %> - Invidious</title>
<link rel="stylesheet" href="/css/playlist-pages.css?v=<%= ASSET_COMMIT %>">
<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed/playlist/<%= encoded_id %>">
<% end %>

<main class="playlist-page" aria-labelledby="playlist-title">
    <header class="playlist-panel playlist-detail">
        <% if user %>
            <a class="playlist-back" href="/feed/playlists"><i class="icon ion-ios-arrow-back" aria-hidden="true"></i> <%= I18n.translate(locale, "Playlists") %></a>
        <% end %>
        <div class="playlist-detail-top">
            <div class="playlist-identity">
                <span class="playlist-emblem" aria-hidden="true"><i class="icon ion-ios-albums"></i></span>
                <div>
                    <h1 id="playlist-title" dir="auto"><%= title %></h1>
                    <div class="playlist-meta">
                        <% if playlist.is_a?(InvidiousPlaylist) %>
                            <% if owns_playlist %>
                                <span class="playlist-badge"><%= I18n.translate(locale, playlist.privacy.to_s) %></span>
                            <% else %>
                                <span dir="auto"><%= author %></span>
                                <span class="playlist-badge"><%= I18n.translate(locale, playlist.privacy.to_s) %></span>
                            <% end %>
                        <% elsif !author.empty? %>
                            <a href="/channel/<%= URI.encode_www_form(playlist.ucid) %>" dir="auto"><%= author %></a>
                        <% elsif subtitle = playlist.subtitle.presence %>
                            <span dir="auto"><%= HTML.escape(subtitle[0..(subtitle.rindex(" • ") || subtitle.size)]) %></span>
                        <% end %>
                        <span><%= I18n.translate_count(locale, "generic_videos_count", playlist.video_count, I18n::NumberFormatting::Separator) %></span>
                        <span><%= I18n.translate(locale, "Updated `x` ago", recode_date(playlist.updated, locale)) %></span>
                    </div>
                </div>
            </div>

            <div class="playlist-actions">
                <% if owns_playlist %>
                    <a class="playlist-primary" href="/add_playlist_items?list=<%= encoded_id %>"><i class="icon ion-md-add" aria-hidden="true"></i> <%= I18n.translate(locale, "playlist_button_add_items") %></a>
                    <a href="/edit_playlist?list=<%= encoded_id %>"><i class="icon ion-md-create" aria-hidden="true"></i> <%= I18n.translate(locale, "generic_button_edit") %></a>
                <% elsif IV::Database::Playlists.exists?(playlist.id) %>
                    <a class="playlist-primary" href="/subscribe_playlist?list=<%= encoded_id %>"><i class="icon ion-md-add" aria-hidden="true"></i> <%= I18n.translate(locale, "Subscribe") %></a>
                <% else %>
                    <a href="/delete_playlist?list=<%= encoded_id %>"><%= I18n.translate(locale, "Unsubscribe") %></a>
                <% end %>
                <a href="/feed/playlist/<%= encoded_id %>"><i class="icon ion-logo-rss" aria-hidden="true"></i> <%= I18n.translate(locale, "generic_button_rss") %></a>

                <% unless playlist.is_a?(InvidiousPlaylist) %>
                    <% youtube_label = HTML.escape(I18n.translate(locale, "View playlist on YouTube")) %>
                    <% instance_label = HTML.escape(I18n.translate(locale, "Switch Invidious Instance")) %>
                    <% instance_url = env.get("preferences").as(Preferences).automatic_instance_redirect ?
                        "/redirect?referer=#{env.get?("current_page")}" : "https://redirect.invidious.io/playlist?list=#{encoded_id}" %>
                    <a href="https://www.youtube.com/playlist?list=<%= encoded_id %>" rel="noreferrer noopener" title="<%= youtube_label %>" aria-label="<%= youtube_label %>"><i class="icon ion-logo-youtube" aria-hidden="true"></i></a>
                    <a href="<%= HTML.escape(instance_url) %>" title="<%= instance_label %>" aria-label="<%= instance_label %>"><i class="icon ion-ios-swap" aria-hidden="true"></i></a>
                <% end %>
            </div>
        </div>

        <% unless playlist.description_html.blank? %>
            <div class="playlist-description" id="descriptionWrapper" dir="auto"><%= playlist.description_html %></div>
        <% end %>
    </header>

    <% if items.empty? %>
        <p class="playlist-empty"><%= I18n.translate(locale, "playlist_page_empty") %></p>
    <% else %>
        <%= rendered "components/items_paginated" %>
    <% end %>
</main>

<% if owns_playlist %>
    <script id="playlist_data" type="application/json">
    <%= {"csrf_token" => URI.encode_www_form(env.get?("csrf_token").try &.as(String) || "")}.to_pretty_json %>
    </script>
    <script src="/js/playlist_widget.js?v=<%= ASSET_COMMIT %>"></script>
<% end %>
