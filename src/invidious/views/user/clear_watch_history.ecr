<% content_for "header" do %>
<title><%= I18n.translate(locale, "Clear watch history") %> - Invidious</title>
<link rel="stylesheet" href="/css/history.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="history-page" aria-labelledby="history-confirm-title">
    <div class="history-confirm">
        <h1 id="history-confirm-title"><%= I18n.translate(locale, "Clear watch history?") %></h1>
        <p><%= I18n.translate(locale, "history_clear_description") %></p>
        <form action="/clear_watch_history?referer=<%= URI.encode_www_form(referer) %>" method="post">
            <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
            <div class="history-actions">
                <a href="<%= HTML.escape(referer) %>"><%= I18n.translate(locale, "generic_button_cancel") %></a>
                <button type="submit" class="history-confirm-delete"><%= I18n.translate(locale, "Clear watch history") %></button>
            </div>
        </form>
    </div>
</main>
