<% ucid = video.ucid %>
<% title = HTML.escape(video.title) %>
<% author = HTML.escape(video.author) %>


<% content_for "header" do %>
<meta name="thumbnail" content="<%= thumbnail %>">
<meta name="description" content="<%= HTML.escape(video.short_description) %>">
<meta name="keywords" content="<%= HTML.escape(video.keywords.join(",")) %>">
<meta property="og:site_name" content="<%= author %> | Invidious">
<meta property="og:url" content="<%= HOST_URL %>/watch?v=<%= video.id %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:image" content="<%= HOST_URL %>/vi/<%= video.id %>/maxres.jpg">
<meta property="og:description" content="<%= HTML.escape(video.short_description) %>">
<meta property="og:type" content="video.other">
<meta property="og:video:url" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta property="og:video:secure_url" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta property="og:video:type" content="text/html">
<meta property="og:video:width" content="1280">
<meta property="og:video:height" content="720">
<meta name="twitter:card" content="player">
<meta name="twitter:url" content="<%= HOST_URL %>/watch?v=<%= video.id %>">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= HTML.escape(video.short_description) %>">
<meta name="twitter:image" content="<%= HOST_URL %>/vi/<%= video.id %>/maxres.jpg">
<meta name="twitter:player" content="<%= HOST_URL %>/embed/<%= video.id %>">
<meta name="twitter:player:width" content="1280">
<meta name="twitter:player:height" content="720">
<link rel="alternate" href="https://www.youtube.com/watch?v=<%= video.id %>">
<%= rendered "components/player_sources" %>
<title><%= title %> - Invidious</title>

<link rel="stylesheet" href="/css/watch-page.css?v=<%= ASSET_COMMIT %>">
<% if plid.try &.starts_with?("RD") %>
    <link rel="stylesheet" href="/css/mix-page.css?v=<%= ASSET_COMMIT %>">
<% end %>
<% end %>

<script id="video_data" type="application/json">
<%=
{
    "id" => video.id,
    "index" => continuation,
    "plid" => plid,
    "length_seconds" => video.length_seconds.to_f,
    "play_next" => related_videos.any? { |rv| rv["id"]? } && !plid && params.continue,
    "next_video" => related_videos.select { |rv| rv["id"]? }[0]?.try &.["id"],
    "youtube_comments_text" => HTML.escape(I18n.translate(locale, "View YouTube comments")),
    "comments_text" => HTML.escape(I18n.translate(locale, "View `x` comments", "{commentCount}")),
    "hide_replies_text" => HTML.escape(I18n.translate(locale, "Hide replies")),
    "show_replies_text" => HTML.escape(I18n.translate(locale, "Show replies")),
    "params" => params,
    "preferences" => preferences,
    "premiere_timestamp" => video.premiere_timestamp.try &.to_unix,
    "vr" => video.vr?,
    "comments_enabled" => video.comments?,
    "projection_type" => video.projection_type,
    "local_disabled" => CONFIG.disabled?("local"),
    "live_now" => video.live_now
}.to_pretty_json
%>
</script>
<script id="config" type="application/json">
<%=
{
    "videojs" => CONFIG.videojs,
}.to_pretty_json
%>
</script>
<% has_sidebar = !!plid || (params.related_videos && related_videos.any? { |rv| rv["id"]? }) %>
<main class="watch-page<%= " watch-with-sidebar" if has_sidebar %>">
    <div class="watch-main">
        <div id="player-container">
            <%= rendered "components/player" %>
        </div>

        <section class="watch-panel watch-info" aria-labelledby="watch-title">
            <h1 id="watch-title" dir="auto"><%= title %></h1>
            <% if !video.is_listed || video.reason || video.live_now || video.premiere_timestamp.try &.> Time.utc %>
                <div class="watch-status">
                    <% if !video.is_listed %>
                        <p>
                            <i class="icon ion-ios-unlock"></i> <%= I18n.translate(locale, "Unlisted") %>
                        </p>
                    <% end %>

                    <% if video.reason %>
                        <p>
                            <%= video.reason %>
                        </p>
                    <% elsif video.premiere_timestamp.try &.> Time.utc %>
                        <p>
                            <%= video.premiere_timestamp.try { |t| I18n.translate(locale, "Premieres in `x`", recode_date((t - Time.utc).ago, locale)) } %>
                        </p>
                    <% elsif video.live_now %>
                        <p>
                            <%= video.premiere_timestamp.try { |t| I18n.translate(locale, "videoinfo_started_streaming_x_ago", recode_date((Time.utc - t).ago, locale)) } %>
                        </p>
                    <% end %>
                </div>
            <% end %>

            <div class="watch-toolbar">
                <div class="watch-channel">
                    <a class="watch-channel-link" href="/channel/<%= ucid %>">
                        <% if !video.author_thumbnail.empty? %>
                            <img src="/ggpht<%= HTML.escape(URI.parse(video.author_thumbnail).request_target) %>" alt="" width="40" height="40">
                        <% end %>
                        <span id="channel-name" dir="auto"><%= author %><% if video.author_verified %> <i class="icon ion-md-checkmark-circle" aria-hidden="true"></i><% end %></span>
                    </a>
                    <% sub_count_text = video.sub_count_text %>
                    <%= rendered "components/subscribe_widget" %>
                </div>

                <div class="watch-actions">
                    <% listen_label = params.listen ? "Video mode" : "Audio mode" %>
                    <% listen_url = "/watch?#{env.params.query}&listen=#{params.listen ? 0 : 1}" %>
                    <a class="watch-button" id="link-iv-listen" data-base-url="<%= HTML.escape(listen_url) %>" href="<%= HTML.escape(listen_url) %>">
                        <i class="icon <%= params.listen ? "ion-ios-videocam" : "ion-md-headset" %>" aria-hidden="true"></i>
                        <%= I18n.translate(locale, listen_label) %>
                    </a>
                </div>
            </div>

            <div class="watch-description">
                <div class="watch-stats">
                    <p id="published-date">
                        <% if video.premiere_timestamp.try &.> Time.utc %>
                            <%= video.premiere_timestamp.try { |t| I18n.translate(locale, "Premieres `x`", t.to_s("%B %-d, %R UTC")) } %>
                        <% else %>
                            <%= I18n.translate(locale, "Shared `x`", video.published.to_s("%B %-d, %Y")) %>
                        <% end %>
                    </p>
                    <span id="views"><%= I18n.translate_count(locale, "generic_views_count", video.views, I18n::NumberFormatting::Short) %></span>
                    <% if video.likes > 0 %>
                        <span id="likes"><i class="icon ion-ios-thumbs-up" aria-hidden="true"></i> <%= number_with_separator(video.likes) %></span>
                    <% end %>
                    <% if video.length_seconds > 0 %>
                        <span><%= video_length_abbreviated(video.length_seconds.seconds) %></span>
                    <% end %>
                </div>
                <% unless video.description_html.blank? %>
                    <% preview = video.description.split.join(" ") %>
                    <% truncated = preview.size > 220 %>
                    <% if !params.extend_desc && (truncated || video.description.count('\n') > 3) %>
                        <% preview = preview[0, 217].sub(/\s+\S*\z/, "").presence || preview[0, 217] if truncated %>
                        <details>
                            <summary>
                                <span class="watch-preview" dir="auto"><%= HTML.escape(preview) %><%= "…" if truncated %></span>
                                <span class="watch-more"><%= I18n.translate(locale, "Show more") %> <i class="icon ion-ios-arrow-down" aria-hidden="true"></i></span>
                                <span class="watch-less"><%= I18n.translate(locale, "Show less") %> <i class="icon ion-ios-arrow-up" aria-hidden="true"></i></span>
                            </summary>
                            <div id="descriptionWrapper" dir="auto"><%= video.description_html %></div>
                        </details>
                    <% else %>
                        <div id="descriptionWrapper" dir="auto"><%= video.description_html %></div>
                    <% end %>
                <% end %>
            </div>

            <details class="watch-tools">
                <summary><%= I18n.translate(locale, "watch_tools") %></summary>
                <div class="watch-actions watch-links">
                    <span id="watch-on-youtube">
                        <%-
                            link_yt_watch = URI.new(scheme: "https", host: "www.youtube.com", path: "/watch", query: "v=#{video.id}")
                            link_yt_embed = URI.new(scheme: "https", host: "www.youtube.com", path: "/embed/#{video.id}")

                            if !plid.nil? && !continuation.nil?
                                link_yt_param = URI::Params{"list" => [plid], "index" => [continuation.to_s]}
                                link_yt_watch = IV::HttpServer::Utils.add_params_to_url(link_yt_watch, link_yt_param)
                                link_yt_embed = IV::HttpServer::Utils.add_params_to_url(link_yt_embed, link_yt_param)
                            end
                        -%>
                        <a id="link-yt-watch" class="watch-button" rel="noreferrer noopener" data-base-url="<%= link_yt_watch %>" href="<%= link_yt_watch %>"><%= I18n.translate(locale, "videoinfo_watch_on_youTube") %></a>
                        <a id="link-yt-embed" class="watch-button" referrerpolicy="origin-when-cross-origin" rel="noopener" data-base-url="<%= link_yt_embed %>" href="<%= link_yt_embed %>"><%= I18n.translate(locale, "videoinfo_youTube_embed_link") %></a>
                    </span>

                    <div id="watch-on-another-invidious-instance">
                        <%- link_iv_other = IV::Frontend::Misc.redirect_url(env) -%>
                        <a id="link-iv-other" class="watch-button" data-base-url="<%= link_iv_other %>" href="<%= link_iv_other %>"><%= I18n.translate(locale, "Switch Invidious Instance") %></a>
                    </div>

                    <div id="embed-link">
                        <%-
                            params_iv_embed = env.params.query.dup
                            params_iv_embed.delete_all("v")

                            link_iv_embed = URI.new(path: "/embed/#{id}")
                            link_iv_embed = IV::HttpServer::Utils.add_params_to_url(link_iv_embed, params_iv_embed)
                        -%>
                        <a id="link-iv-embed" class="watch-button" data-base-url="<%= link_iv_embed %>" href="<%= link_iv_embed %>"><%= I18n.translate(locale, "videoinfo_invidious_embed_link") %></a>
                    </div>

                    <div id="annotations">
                        <% if params.annotations %>
                            <a class="watch-button" href="/watch?<%= HTML.escape(env.params.query.to_s) %>&amp;iv_load_policy=3">
                                <%= I18n.translate(locale, "Hide annotations") %>
                            </a>
                        <% else %>
                            <a class="watch-button" href="/watch?<%= HTML.escape(env.params.query.to_s) %>&amp;iv_load_policy=1">
                                <%=I18n.translate(locale, "Show annotations")%>
                            </a>
                        <% end %>
                    </div>
                </div>
                <div class="watch-forms">
                    <% if user %>
                        <% playlists = Invidious::Database::Playlists.select_user_created_playlists(user.email) %>
                        <% if !playlists.empty? %>
                            <form data-feedback-submit="playlistAdded" class="pure-form pure-form-stacked" action="/playlist_ajax?action=add_video&amp;referer=<%= env.get("current_page") %>" method="post">
                                <div class="pure-control-group">
                                    <label for="playlist_id"><%= I18n.translate(locale, "Add to playlist: ") %></label>
                                    <select name="playlist_id" id="playlist_id">
                                        <% playlists.each do |plid, playlist_title| %>
                                            <option data-plid="<%= plid %>" value="<%= plid %>" <%= "selected" if user.preferences.default_playlist == plid %>><%= HTML.escape(playlist_title) %></option>
                                        <% end %>
                                    </select>
                                </div>

                                <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                                <input type="hidden" name="video_id" value="<%= video.id %>">
                                <button type="submit" class="watch-button">
                                    <%= I18n.translate(locale, "Add to playlist") %>
                                </button>
                            </form>
                        <% end %>
                    <% end %>

                    <%= Invidious::Frontend::WatchPage.download_widget(locale, video, video_assets) %>
                </div>
            </details>
            <details class="watch-tools">
                <summary><%= I18n.translate(locale, "watch_video_details") %></summary>
                <div class="watch-facts">
                    <% if video.ai_made %>
                        <p id="ai_made"><%= I18n.translate(locale, "video_details_ai_made") %>
                            <%= I18n.translate_bool(locale, video.ai_made) %>
                        </p>
                    <% end %>
                    <p id="genre"><%= I18n.translate(locale, "Genre: ") %>
                        <% if !video.genre_url %>
                            <%= video.genre %>
                        <% else %>
                            <a href="<%= video.genre_url %>"><%= video.genre %></a>
                        <% end %>
                    </p>
                    <% if video.license %>
                        <% if video.license.empty? %>
                            <p id="license"><%= I18n.translate(locale, "License: ") %><%= I18n.translate(locale, "Standard YouTube license") %></p>
                        <% else %>
                            <p id="license"><%= I18n.translate(locale, "License: ") %><%= video.license %></p>
                        <% end %>
                    <% end %>
                    <p id="family_friendly"><%= I18n.translate(locale, "Family friendly? ") %><%= I18n.translate_bool(locale, video.is_family_friendly) %></p>
                    <% if video.allowed_regions.size != REGIONS.size %>
                        <p id="allowed_regions">
                            <% if video.allowed_regions.size < REGIONS.size // 2 %>
                                <%= I18n.translate(locale, "Whitelisted regions: ") %><%= video.allowed_regions.join(", ") %>
                            <% else %>
                                <%= I18n.translate(locale, "Blacklisted regions: ") %><%= (REGIONS.to_a - video.allowed_regions).join(", ") %>
                            <% end %>
                        </p>
                    <% end %>
                </div>
            </details>
            <% unless video.music.empty? %>
                <details class="watch-tools">
                    <summary><%= I18n.translate(locale, "Music in this video") %></summary>
                    <div class="watch-facts">
                    <% video.music.each do |music| %>
                        <div class="music-item">
                            <p class="music-song"><%= I18n.translate(locale, "Song: ") %><%= music.song %></p>
                            <p class="music-artist"><%= I18n.translate(locale, "Artist: ") %><%= music.artist %></p>
                            <p class="music-album"><%= I18n.translate(locale, "Album: ") %><%= music.album %></p>
                        </div>
                    <% end %>
                    </div>
                </details>
            <% end %>
        </section>
    </div>

    <% if has_sidebar %>
        <aside class="watch-sidebar">
            <% if plid %>
                <div id="playlist" class="watch-panel"></div>
            <% end %>
            <% if params.related_videos && related_videos.any? { |rv| rv["id"]? } %>
                <section class="watch-panel" aria-labelledby="watch-related-title">
                    <h2 id="watch-related-title"><%= I18n.translate(locale, "watch_recommendations") %></h2>
                    <label class="watch-autoplay"<% if plid %> hidden<% end %>>
                        <input name="continue" id="continue" type="checkbox" <% if params.continue %>checked<% end %>>
                        <%= I18n.translate(locale, "preferences_continue_label") %>
                    </label>
                    <ul class="watch-related">
                        <% related_videos.each do |rv| %>
                            <% if rv_id = rv["id"]? %>
                                <% related_url = "/watch?v=#{rv_id}&listen=#{params.listen}" %>
                                <li class="watch-related-item<%= " watch-related-text" if preferences.thin_mode %>">
                                    <% unless preferences.thin_mode %>
                                        <a class="watch-related-thumb" tabindex="-1" aria-hidden="true" href="<%= HTML.escape(related_url) %>">
                                            <img loading="lazy" src="/vi/<%= HTML.escape(rv_id) %>/mqdefault.jpg" alt="" width="320" height="180">
                                            <% if (duration = rv["length_seconds"]?.try &.to_i?) && duration > 0 %>
                                                <span><%= recode_length_seconds(duration) %></span>
                                            <% end %>
                                        </a>
                                    <% end %>
                                    <div class="watch-related-info">
                                        <a class="watch-related-title" dir="auto" href="<%= HTML.escape(related_url) %>"><%= HTML.escape(rv["title"]) %></a>
                                        <div class="watch-related-meta" dir="auto">
                                            <% if channel_id = rv["ucid"]?.presence %>
                                                <a href="/channel/<%= HTML.escape(channel_id) %>"><%= HTML.escape(rv["author"]? || "") %></a>
                                            <% else %>
                                                <%= HTML.escape(rv["author"]? || "") %>
                                            <% end %>
                                            <% if rv["author_verified"]? == "true" %>
                                                <i class="icon ion-md-checkmark-circle" aria-hidden="true"></i>
                                            <% end %>
                                        </div>
                                        <% if count = rv["short_view_count"]?.presence %>
                                            <div class="watch-related-meta"><%= I18n.translate_count(locale, "generic_views_count", short_text_to_number(count), I18n::NumberFormatting::Short) %></div>
                                        <% end %>
                                    </div>
                                </li>
                            <% end %>
                        <% end %>
                    </ul>
                </section>
            <% end %>
        </aside>
    <% end %>

    <section class="watch-panel watch-comments" aria-labelledby="watch-comments-title">
        <h2 id="watch-comments-title"><%= I18n.translate(locale, "watch_comments") %></h2>
        <div id="comments" class="comments">
                <% if (params.comments <=> ["", ""]) == 0 %>
                    <div id="comments-disabled-message" class="h-box v-box">
                        <p><b><%= HTML.escape(I18n.translate(locale, "comments_invidious_disabled_text")) %></b></p>
                    </div>
                <% else %>
                    <% if video.comments? %>
                        <% if nojs %>
                            <%= comment_html %>
                        <% else %>
                            <noscript>
                                <a href="/watch?<%= HTML.escape(env.params.query.to_s) %>&amp;nojs=1">
                                    <%= I18n.translate(locale, "Hi! Looks like you have JavaScript turned off. Click here to view comments, keep in mind they may take a bit longer to load.") %>
                                </a>
                            </noscript>
                        <% end %>
                    <% else %>
                        <% if !nojs %>
                            <div id="comments-turned-off-on-video-message" class="h-box v-box">
                                <p><b><%= HTML.escape(I18n.translate(locale, "comments_youtube_disabled_text")) %></b></p>
                            </div>
                        <% end %>
                    <% end %>
                <% end %>
        </div>
    </section>
</main>

<script src="/js/comments.js?v=<%= ASSET_COMMIT %>"></script>
<script src="/js/watch.js?v=<%= ASSET_COMMIT %>"></script>
