<%-
  thin_mode = env.get("preferences").as(Preferences).thin_mode
  video_item = !item.is_a?(SearchChannel | SearchHashtag | SearchPlaylist | InvidiousPlaylist | Category | ProblematicTimelineItem)
  playlist_item = item.is_a?(SearchPlaylist | InvidiousPlaylist)
  item_watched = video_item && item.responds_to?(:id) && env.get?("user").try &.as(User).watched.index(item.id) != nil
  author_verified = item.responds_to?(:author_verified) && item.author_verified
-%>

<div class="pure-u-1 pure-u-md-1-4<%= " video-card-cell" if video_item || playlist_item || item.is_a?(SearchChannel) %>">
    <div class="<%= (video_item || playlist_item) ? "video-card" : (item.is_a?(SearchChannel) ? "channel-result-card" : "h-box") %>">
        <% case item when %>
        <% when SearchChannel %>
            <a class="channel-result-link" href="/channel/<%= item.ucid %>">
                <span class="channel-result-identity">
                    <span class="channel-result-avatar" aria-hidden="true">
                        <%= HTML.escape(item.author.strip[0, 1].upcase) %>
                        <% unless thin_mode || item.author_thumbnail.blank? %>
                            <img loading="lazy" decoding="async" width="64" height="64" src="/ggpht<%= HTML.escape(URI.parse(item.author_thumbnail).request_target.gsub(/=s\d+/, "=s176")) %>" alt="">
                        <% end %>
                    </span>
                    <span class="channel-result-name">
                        <strong dir="auto"><%= HTML.escape(item.author) %><% if author_verified %> <i class="icon ion-md-checkmark-circle" aria-hidden="true"></i><% end %></strong>
                        <% if handle = item.channel_handle.presence %>
                            <span dir="auto"><%= HTML.escape(handle) %></span>
                        <% end %>
                    </span>
                </span>
                <span class="channel-result-meta">
                    <span><%= I18n.translate_count(locale, "generic_subscribers_count", item.subscriber_count, I18n::NumberFormatting::Separator) %></span>
                    <% if !item.auto_generated && item.channel_handle.nil? %>
                        <span><%= I18n.translate_count(locale, "generic_videos_count", item.video_count, I18n::NumberFormatting::Separator) %></span>
                    <% end %>
                </span>
                <% unless item.description_html.blank? %>
                    <span class="channel-result-description" dir="auto"><%= HTML.escape(Invidious::Helpers.html_to_content(item.description_html)) %></span>
                <% end %>
                <span class="channel-result-action"><%= I18n.translate(locale, "channel_result_open") %> <i class="icon ion-ios-arrow-forward" aria-hidden="true"></i></span>
            </a>
        <% when SearchHashtag %>
            <% if !thin_mode %>
                <a tabindex="-1" href="<%= item.url %>">
                    <center><img style="width:56.25%" src="/hashtag.svg" alt="" /></center>
                </a>
            <%- else -%>
                <div class="thumbnail-placeholder" style="width:56.25%"></div>
            <% end %>

            <div class="video-card-row">
                <div class="flex-left"><a href="<%= item.url %>"><%= HTML.escape(item.title) %></a></div>
            </div>

            <div class="video-card-row">
                <%- if item.video_count != 0 -%>
                    <p><%= I18n.translate_count(locale, "generic_videos_count", item.video_count, I18n::NumberFormatting::Separator) %></p>
                <%- end -%>
            </div>

            <div class="video-card-row">
                <%- if item.channel_count != 0 -%>
                    <p><%= I18n.translate_count(locale, "generic_channels_count", item.channel_count, I18n::NumberFormatting::Separator) %></p>
                <%- end -%>
            </div>
        <% when SearchPlaylist, InvidiousPlaylist %>
            <%
                is_mix = item.id.starts_with?("RD")
                thumbnail = item.thumbnail unless thin_mode && !is_mix
                thumbnail_path = thumbnail.try { |url| URI.parse(url).request_target }
                playlist_id = URI.encode_www_form(item.id)
                link_url = if is_mix
                    continuation = thumbnail_path.try(&.split("/", 4)[2]?) || "-----------"
                    "/mix?list=#{playlist_id}&continuation=#{URI.encode_www_form(continuation)}"
                else
                    "/playlist?list=#{playlist_id}"
                end
                same_author = item.author.strip.downcase == item.title.strip.downcase
            %>

            <div class="thumbnail video-card-thumbnail">
                <% if !thin_mode && thumbnail_path.presence %>
                    <a tabindex="-1" href="<%= HTML.escape(link_url) %>">
                        <img loading="lazy" decoding="async" class="thumbnail" src="<%= HTML.escape(thumbnail_path.not_nil!) %>" alt="">
                    </a>
                <% else %>
                    <div class="thumbnail-placeholder"></div>
                <% end %>
                <div class="top-left-overlay">
                    <span class="video-card-badge video-card-playlist"><i class="icon ion-ios-albums" aria-hidden="true"></i> <%= I18n.translate(locale, "search_filters_type_option_playlist") %></span>
                </div>
                <div class="bottom-right-overlay video-card-badge-area">
                    <span class="video-card-badge"><%= I18n.translate_count(locale, "generic_videos_count", item.video_count, I18n::NumberFormatting::Separator) %></span>
                </div>
            </div>

            <div class="video-card-body">
                <a class="video-card-title" href="<%= HTML.escape(link_url) %>" dir="auto"><%= HTML.escape(item.title) %></a>
                <% unless item.author.empty? %>
                    <div class="video-card-byline">
                        <% if !item.ucid.to_s.empty? %>
                            <a class="video-card-author" href="/channel/<%= item.ucid %>" dir="auto">
                                <%= same_author ? I18n.translate(locale, "channel_result_open") : HTML.escape(item.author) %><% if author_verified && !same_author %> <i class="icon ion-md-checkmark-circle" aria-hidden="true"></i><% end %>
                            </a>
                        <% elsif !same_author %>
                            <span dir="auto"><%= HTML.escape(item.author) %></span>
                        <% end %>
                    </div>
                <% end %>
            </div>
        <% when Category %>
        <% when ProblematicTimelineItem %>
            <div class="error-card">
                <div class="explanation">
                    <i class="icon ion-ios-alert"></i>
                    <h4><%=I18n.translate(locale, "timeline_parse_error_placeholder_heading")%></h4>
                    <p><%=I18n.translate(locale, "timeline_parse_error_placeholder_message")%></p>
                </div>
                <details>
                    <summary class="pure-button pure-button-secondary"><%=I18n.translate(locale, "timeline_parse_error_show_technical_details")%></summary>
                    <pre class="error-issue-template"><%=Errors.get_issue_template(env, item.parse_exception)[1]%></pre>
                </details>
            </div>
        <% else %>
            <%-
              live_now = (item.responds_to?(:live_now) && item.live_now) || (item.responds_to?(:badges) && item.badges.live_now?)
              scheduled_at = item.responds_to?(:premiere_timestamp) ? item.premiere_timestamp : nil
              scheduled_at = nil if live_now || (scheduled_at && scheduled_at <= Time.utc)
              is_livestream = (item.responds_to?(:is_livestream) && item.is_livestream) || env.request.path.ends_with?("/streams")
              mark_watched_label = HTML.escape(I18n.translate(locale, "video_card_mark_watched"))
              # `endpoint_params` is used for the "video-context-buttons" component
              if item.is_a?(PlaylistVideo)
                link_url = "/watch?v=#{item.id}&list=#{item.plid}&index=#{item.index}"
                endpoint_params = "?v=#{item.id}&list=#{item.plid}"
              elsif item.is_a?(MixVideo)
                link_url = "/watch?v=#{item.id}&list=#{item.rdid}"
                endpoint_params = "?v=#{item.id}&list=#{item.rdid}"
              else
                link_url = "/watch?v=#{item.id}"
                endpoint_params = "?v=#{item.id}"
              end
            -%>

            <div class="thumbnail video-card-thumbnail">
                <%- if !thin_mode -%>
                    <a tabindex="-1" href="<%= link_url %>">
                        <img loading="lazy" decoding="async" class="thumbnail" src="/vi/<%= item.id %>/mqdefault.jpg" alt="" />

                        <% if item_watched %>
                            <div class="watched-overlay"></div>
                            <div class="watched-indicator" data-length="<%= item.length_seconds %>" data-id="<%= item.id %>"></div>
                        <% end %>
                    </a>
                <%- else -%>
                    <div class="thumbnail-placeholder"></div>
                <%- end -%>

                <div class="top-left-overlay">
                    <%- if env.get? "show_watched" -%>
                        <form data-feedback-submit="watched" action="/watch_ajax?action=mark_watched&id=<%= item.id %>&referer=<%= env.get("current_page") %>" method="post">
                            <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                            <button type="submit" class="pure-button pure-button-secondary low-profile"  title="<%= mark_watched_label %>" aria-label="<%= mark_watched_label %>">
                                <i data-mouse="switch_classes" data-switch-classes="ion-ios-eye-off,ion-ios-eye" class="icon ion-ios-eye"></i>
                            </button>
                        </form>
                    <%- end -%>

                    <%- if plid_form = env.get?("add_playlist_items") -%>
                        <%- form_parameters = "action=add_video&video_id=#{item.id}&playlist_id=#{plid_form}&referer=#{env.get("current_page")}" -%>
                        <form data-feedback-submit="playlistAdded" action="/playlist_ajax?<%= form_parameters %>" method="post">
                            <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                            <button type="submit" class="pure-button pure-button-secondary low-profile"
                                    aria-label="<%= HTML.escape(I18n.translate(locale, "playlist_button_add_items")) %>"><i class="icon ion-md-add"></i></button>
                        </form>
                    <%- elsif item.is_a?(PlaylistVideo) && (plid_form = env.get?("remove_playlist_items")) -%>
                        <%- form_parameters = "action=remove_video&set_video_id=#{item.index}&playlist_id=#{plid_form}&referer=#{env.get("current_page")}" -%>
                        <form data-feedback-submit="playlistRemoved" action="/playlist_ajax?<%= form_parameters %>" method="post">
                            <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                            <button type="submit" class="pure-button pure-button-secondary low-profile"
                                    aria-label="<%= HTML.escape(I18n.translate(locale, "playlist_remove_item")) %>"><i class="icon ion-md-trash"></i></button>
                        </form>
                    <%- end -%>
                </div>

                <div class="bottom-right-overlay video-card-badge-area">
                    <%- if item.responds_to?(:is_members_only) && item.is_members_only -%>
                        <span class="video-card-badge video-card-members"><i class="icon ion-ios-lock" aria-hidden="true"></i> <%= I18n.translate(locale, "video_card_members_only") %></span>
                    <%- end -%>
                    <%- if live_now -%>
                        <span class="video-card-badge video-card-live"><i class="icon ion-ios-radio" aria-hidden="true"></i> <%= I18n.translate(locale, "LIVE") %></span>
                    <%- elsif scheduled_at -%>
                        <span class="video-card-badge video-card-scheduled"><i class="icon ion-ios-calendar" aria-hidden="true"></i> <%= I18n.translate(locale, is_livestream ? "video_card_scheduled_live" : "video_card_scheduled") %></span>
                    <%- elsif item.length_seconds != 0 -%>
                        <span class="video-card-badge"><%= recode_length_seconds(item.length_seconds) %></span>
                    <%- end -%>
                </div>
            </div>

            <div class="video-card-body">
                <a class="video-card-title" href="<%= link_url %>" dir="auto"><%= HTML.escape(item.title) %></a>

                <div class="video-card-byline">
                    <% unless item.author.empty? %>
                        <% if !item.ucid.to_s.empty? %>
                            <a class="video-card-author" href="/channel/<%= item.ucid %>" dir="auto">
                                <%= HTML.escape(item.author) %><% if author_verified %> <i class="icon ion-md-checkmark-circle" aria-hidden="true"></i><% end %>
                            </a>
                        <% else %>
                            <span dir="auto"><%= HTML.escape(item.author) %></span>
                        <% end %>
                    <% end %>
                    <%= rendered "components/video-context-buttons" %>
                </div>

                <% if scheduled_at %>
                    <div class="video-card-schedule">
                        <i class="icon ion-ios-time" aria-hidden="true"></i>
                        <time data-video-schedule datetime="<%= scheduled_at.to_utc.to_rfc3339 %>"><%= scheduled_at.to_utc.to_s("%Y-%m-%d %H:%M UTC") %></time>
                    </div>
                <% else %>
                    <div class="video-card-meta">
                        <% if !live_now && item.responds_to?(:published) && (Time.utc - item.published) > 1.minute %>
                            <span dir="auto"><%= I18n.translate(locale, "Shared `x` ago", recode_date(item.published, locale)) %></span>
                        <% end %>
                        <% if item.responds_to?(:views) && item.views %>
                            <span dir="auto"><%= I18n.translate_count(locale, "generic_views_count", item.views || 0, I18n::NumberFormatting::Short) %></span>
                        <% end %>
                    </div>
                <% end %>
            </div>
        <% end %>
    </div>
</div>
