<% content_for "header" do %>
<title><%= I18n.translate(locale, "Token") %> - Invidious</title>
<link rel="stylesheet" href="/css/account.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="account-page account-narrow" aria-labelledby="account-title">
    <div class="account-panel">
        <% access_token = env.get? "access_token" %>
        <div class="account-heading">
            <span class="account-icon" aria-hidden="true"><i class="icon ion-ios-key"></i></span>
            <h1 id="account-title">
                <% if access_token %>
                    <%= I18n.translate(locale, "Token") %>
                <% elsif callback_url %>
                    <% destination = "#{callback_url.scheme}://#{callback_url.host}" %>
                    <% destination += ":#{callback_url.port}" if callback_url.port %>
                    <%= HTML.escape(I18n.translate(locale, "Authorize token for `x`?", destination)) %>
                <% else %>
                    <%= I18n.translate(locale, "Authorize token?") %>
                <% end %>
            </h1>
        </div>

        <% if access_token %>
            <code class="account-secret"><%= HTML.escape(access_token.as(String)) %></code>
            <div class="account-actions">
                <a class="account-button" href="/preferences"><%= I18n.translate(locale, "Preferences") %></a>
                <a class="account-button account-primary" href="/token_manager"><%= I18n.translate(locale, "Token manager") %></a>
            </div>
        <% else %>
            <form action="/authorize_token" method="post">
                <% unless scopes.empty? %>
                    <ul class="account-list account-scopes">
                        <% scopes.each do |scope| %>
                            <li><code><%= HTML.escape(scope) %></code></li>
                        <% end %>
                    </ul>
                <% end %>

                <% scopes.each_with_index do |scope, i| %>
                    <input type="hidden" name="scopes[<%= i %>]" value="<%= HTML.escape(scope) %>">
                <% end %>
                <% if callback_url %>
                    <input type="hidden" name="callbackUrl" value="<%= HTML.escape(callback_url.to_s) %>">
                <% end %>
                <% if expire %>
                    <input type="hidden" name="expire" value="<%= expire %>">
                <% end %>
                <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">

                <div class="account-actions">
                    <a class="account-button" href="<%= HTML.escape(callback_url.try(&.to_s) || "/") %>"><%= I18n.translate(locale, "generic_button_cancel") %></a>
                    <button type="submit" class="account-button account-primary"><%= I18n.translate(locale, "account_authorize") %></button>
                </div>
            </form>
        <% end %>
    </div>
</main>
