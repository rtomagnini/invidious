<% content_for "header" do %>
<title><%= I18n.translate(locale, "Token manager") %> - Invidious</title>
<link rel="stylesheet" href="/css/account.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="account-page" aria-labelledby="account-title">
    <div class="account-top">
        <div class="account-heading">
            <span class="account-icon" aria-hidden="true"><i class="icon ion-ios-key"></i></span>
            <div>
                <h1 id="account-title"><%= I18n.translate(locale, "Token manager") %></h1>
                <p><%= I18n.translate_count(locale, "tokens_count", tokens.size, I18n::NumberFormatting::HtmlSpan) %></p>
            </div>
        </div>
        <a class="account-button" href="/preferences?referer=<%= URI.encode_www_form(referer) %>">
            <i class="icon ion-ios-arrow-back" aria-hidden="true"></i>
            <%= I18n.translate(locale, "Preferences") %>
        </a>
    </div>

    <% unless tokens.empty? %>
        <ul class="account-list account-tokens">
            <% tokens.each do |token| %>
                <% current = token[:session] == sid %>
                <% token_suffix = token[:session].size > 8 ? "…#{token[:session][-8..]}" : token[:session] %>
                <li class="account-panel account-token">
                    <div class="account-token-info">
                        <code><%= HTML.escape(token_suffix) %></code>
                        <% if current %>
                            <strong class="account-tag"><%= I18n.translate(locale, "account_current_session") %></strong>
                        <% end %>
                        <time datetime="<%= token[:issued].to_rfc3339 %>">
                            <%= I18n.translate(locale, "`x` ago", recode_date(token[:issued], locale)) %>
                        </time>
                        <details class="account-token-value">
                            <summary><%= I18n.translate(locale, "account_show_token") %></summary>
                            <code class="account-secret"><%= HTML.escape(token[:session]) %></code>
                        </details>
                    </div>
                    <details class="account-revoke">
                        <summary class="account-button"><%= I18n.translate(locale, "revoke") %></summary>
                        <form action="/token_ajax?action=revoke_token&amp;session=<%= URI.encode_www_form(token[:session]) %>&amp;referer=%2Ftoken_manager" method="post">
                            <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                            <p><%= I18n.translate(locale, current ? "account_revoke_current" : "account_revoke_description") %></p>
                            <button type="submit" class="account-button account-danger"><%= I18n.translate(locale, "revoke") %></button>
                        </form>
                    </details>
                </li>
            <% end %>
        </ul>
    <% end %>
</main>
