<div id="feedback-toasts" class="feedback-toasts"></div>
<div id="feedback-status" class="site-visually-hidden" role="status" aria-atomic="true"></div>
<div id="feedback-strings" hidden
     data-watched="<%= HTML.escape(I18n.translate(locale, "feedback_watched")) %>"
     data-unwatched="<%= HTML.escape(I18n.translate(locale, "feedback_unwatched")) %>"
     data-undo="<%= HTML.escape(I18n.translate(locale, "feedback_undo")) %>"
     data-undone="<%= HTML.escape(I18n.translate(locale, "feedback_undone")) %>"
     data-playlist-added="<%= HTML.escape(I18n.translate(locale, "feedback_playlist_added")) %>"
     data-playlist-removed="<%= HTML.escape(I18n.translate(locale, "feedback_playlist_removed")) %>"
     data-filter-saved="<%= HTML.escape(I18n.translate(locale, "feedback_filter_saved")) %>"
     data-filter-error="<%= HTML.escape(I18n.translate(locale, "feedback_filter_error")) %>"
     data-action-error="<%= HTML.escape(I18n.translate(locale, "feedback_action_error")) %>"
     data-close="<%= HTML.escape(I18n.translate(locale, "feedback_close")) %>"></div>
