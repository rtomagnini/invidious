<% content_for "header" do %>
<title><%= I18n.translate(locale, "Subscriptions") %> - Invidious</title>
<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed/private?token=<%= token %>" />
<% end %>

<div class="subscription-toolbar h-box">
    <h1><%= I18n.translate(locale, "Subscriptions") %></h1>
    <div class="subscription-toolbar-actions">
        <a href="/subscription_manager"><i class="icon ion-ios-list" aria-hidden="true"></i> <%= I18n.translate(locale, "Manage subscriptions") %></a>
        <a href="/feed/history"><i class="icon ion-ios-time" aria-hidden="true"></i> <%= I18n.translate(locale, "Watch history") %></a>
        <a href="/feed/private?token=<%= token %>" title="<%= I18n.translate(locale, "generic_button_rss") %>" aria-label="<%= I18n.translate(locale, "generic_button_rss") %>">
            <i class="icon ion-logo-rss" aria-hidden="true"></i>
        </a>
    </div>
</div>

<% if CONFIG.enable_user_notifications && !notifications.empty? %>
    <section aria-label="<%= HTML.escape(I18n.translate(locale, "header_notifications")) %>" class="subscription-notifications">
        <div class="pure-g">
            <% notifications.each do |item| %>
                <%= rendered "components/item" %>
            <% end %>
        </div>
    </section>
<% end %>

<script id="watched_data" type="application/json">
<%=
{
    "csrf_token" => URI.encode_www_form(env.get?("csrf_token").try &.as(String) || "")
}.to_pretty_json
%>
</script>
<script src="/js/watched_widget.js?v=<%= ASSET_COMMIT %>"></script>


<div class="pure-g">
<% videos.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>

<script src="/js/watched_indicator.js"></script>

<%=
  IV::Frontend::Pagination.nav_numeric(locale,
    base_url: base_url,
    current_page: page,
    show_next: ((videos.size + notifications.size) == max_results)
  )
%>
