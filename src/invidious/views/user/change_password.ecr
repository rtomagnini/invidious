<% content_for "header" do %>
<title><%= I18n.translate(locale, "Change password") %> - Invidious</title>
<link rel="stylesheet" href="/css/account.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="account-page account-narrow" aria-labelledby="account-title">
    <div class="account-panel">
        <div class="account-heading">
            <span class="account-icon" aria-hidden="true"><i class="icon ion-ios-lock"></i></span>
            <h1 id="account-title"><%= I18n.translate(locale, "Change password") %></h1>
        </div>
        <form class="account-form" action="/change_password?referer=<%= URI.encode_www_form(referer) %>" method="post">
            <label class="account-field" for="password">
                <%= I18n.translate(locale, "Password") %>
                <input required id="password" name="password" type="password" autocomplete="current-password">
            </label>
            <label class="account-field" for="new-password">
                <%= I18n.translate(locale, "New password") %>
                <input required id="new-password" name="new_password[0]" type="password" autocomplete="new-password">
            </label>
            <label class="account-field" for="confirm-password">
                <%= I18n.translate(locale, "account_confirm_password") %>
                <input required id="confirm-password" name="new_password[1]" type="password" autocomplete="new-password">
            </label>

            <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
            <div class="account-actions">
                <a class="account-button" href="<%= HTML.escape(referer) %>"><%= I18n.translate(locale, "generic_button_cancel") %></a>
                <button type="submit" name="action" value="change_password" class="account-button account-primary"><%= I18n.translate(locale, "Change password") %></button>
            </div>
        </form>
    </div>
</main>
