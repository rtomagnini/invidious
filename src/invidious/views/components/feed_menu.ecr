<%
    feed_menu = preferences.feed_menu
    feed_menu = feed_menu.reject { |item| {"Subscriptions", "Playlists"}.includes?(item) } unless header_user
    active_path = env.request.path
%>
<% unless feed_menu.empty? %>
    <nav class="site-feed-nav" aria-label="<%= HTML.escape(I18n.translate(locale, "header_feed_navigation")) %>">
        <% feed_menu.each do |feed| %>
            <% feed_path = "/feed/#{feed.downcase}" %>
            <a href="<%= feed_path %>" <%= %(aria-current="page") if active_path == feed_path %>>
                <%= I18n.translate(locale, feed) %>
            </a>
        <% end %>
    </nav>
<% end %>
