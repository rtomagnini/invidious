<%
    preview = channel.description.split.join(" ")
    truncated_description = preview.size > 180
    expandable_description = truncated_description || channel.description.count('\n') > 2
    if truncated_description
        preview = preview[0, 177].sub(/\s+\S*\z/, "").presence || preview[0, 177]
    end
%>
<div class="channel-page">
    <section class="channel-hero" aria-labelledby="channel-title">
        <% if banner = channel.banner %>
            <img class="channel-hero-banner" src="/ggpht<%= HTML.escape(URI.parse(banner.gsub("=w1060-", "=w1280-")).request_target) %>" alt="">
        <% end %>

        <div class="channel-hero-body">
            <div class="channel-hero-top">
                <div class="channel-identity">
                    <img src="/ggpht<%= HTML.escape(channel_profile_pic) %>" alt="" width="64" height="64">
                    <div>
                        <h1 id="channel-title" dir="auto"><%= author %><% if channel.verified %> <i class="icon ion-md-checkmark-circle" aria-hidden="true"></i><% end %></h1>
                        <% if pronouns = channel.pronouns.presence %>
                            <p class="channel-hero-pronouns" dir="auto"><%= HTML.escape(pronouns) %></p>
                        <% end %>
                    </div>
                </div>

                <div class="channel-actions">
                    <% sub_count_text = number_to_short_text(channel.sub_count) %>
                    <%= rendered "components/subscribe_widget" %>
                    <a href="/feed/channel/<%= ucid %>" class="channel-action">
                        <i class="icon ion-logo-rss" aria-hidden="true"></i> <%= I18n.translate(locale, "generic_button_rss") %>
                    </a>
                    <% youtube_label = HTML.escape(I18n.translate(locale, "View channel on YouTube")) %>
                    <a href="<%= HTML.escape(youtube_url) %>" class="channel-action" title="<%= youtube_label %>" aria-label="<%= youtube_label %>">
                        <i class="icon ion-logo-youtube" aria-hidden="true"></i>
                    </a>
                    <% instance_label = HTML.escape(I18n.translate(locale, "Switch Invidious Instance")) %>
                    <a href="<%= HTML.escape(redirect_url) %>" class="channel-action" title="<%= instance_label %>" aria-label="<%= instance_label %>">
                        <i class="icon ion-ios-swap" aria-hidden="true"></i>
                    </a>
                </div>
            </div>

            <% unless channel.description_html.blank? %>
                <div class="channel-description">
                    <% if expandable_description %>
                        <details>
                            <summary>
                                <span class="channel-description-preview" dir="auto"><%= HTML.escape(preview) %><%= "…" if truncated_description %></span>
                                <span class="channel-description-more"><%= I18n.translate(locale, "Show more") %> <i class="icon ion-ios-arrow-down" aria-hidden="true"></i></span>
                                <span class="channel-description-less"><%= I18n.translate(locale, "Show less") %> <i class="icon ion-ios-arrow-up" aria-hidden="true"></i></span>
                            </summary>
                            <div class="channel-description-full" dir="auto"><%= channel.description_html %></div>
                        </details>
                    <% else %>
                        <div class="channel-description-full" dir="auto"><%= channel.description_html %></div>
                    <% end %>
                </div>
            <% end %>
        </div>
    </section>

    <div class="channel-toolbar">
        <nav class="channel-tabs" aria-label="<%= HTML.escape(I18n.translate(locale, "channel_sections")) %>">
            <%= Invidious::Frontend::ChannelPage.generate_tabs_links(locale, channel, selected_tab) %>
        </nav>
        <% unless sort_options.empty? %>
            <nav class="channel-sort" aria-label="<%= HTML.escape(I18n.translate(locale, "channel_sort_by")) %>">
                <% sort_options.each do |sort| %>
                    <a href="<%= relative_url %>?sort_by=<%= sort %>" <%= %(aria-current="true") if sort_by == sort %>><%= I18n.translate(locale, sort) %></a>
                <% end %>
            </nav>
        <% end %>
    </div>
</div>
