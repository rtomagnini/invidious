<% content_for "header" do %>
<meta name="description" content="<%= HTML.escape(I18n.translate(locale, "An alternative front-end to YouTube")) %>">
<title>
    <% if env.get("preferences").as(Preferences).default_home != "Trending" %>
        <%= I18n.translate(locale, "Trending") %> - Invidious
    <% else %>
        Invidious
    <% end %>
</title>
<link rel="stylesheet" href="/css/discovery.css?v=<%= ASSET_COMMIT %>">
<link rel="stylesheet" href="/css/trending.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="discovery-page trending-page" aria-labelledby="trending-title">
    <header class="discovery-header">
        <h1 id="trending-title"><%= I18n.translate(locale, "Trending") %></h1>
        <div class="trending-controls">
            <nav class="trending-categories" aria-label="<%= HTML.escape(I18n.translate(locale, "trending_categories")) %>">
                <% [{"Livestreams", "ion-ios-radio"}, {"Gaming", "ion-logo-game-controller-b"}].each do |option, icon| %>
                    <a href="/feed/trending?type=<%= option %>&amp;region=<%= region %>" <%= %(aria-current="page") if trending_type == option %>>
                        <i class="icon <%= icon %>" aria-hidden="true"></i> <%= I18n.translate(locale, option) %>
                    </a>
                <% end %>
            </nav>

            <form class="trending-region-form" action="/feed/trending" method="get">
                <input type="hidden" name="type" value="<%= trending_type %>">
                <label for="trending-region"><%= I18n.translate(locale, "trending_region") %></label>
                <select name="region" id="trending-region">
                    <% I18n::CONTENT_REGIONS.each do |option| %>
                        <option value="<%= option %>" <%= "selected" if option == region %>><%= option %></option>
                    <% end %>
                </select>
                <button type="submit"><%= I18n.translate(locale, "trending_apply_region") %></button>
            </form>

            <% if plid %>
                <a class="trending-playlist" href="/playlist?list=<%= URI.encode_www_form(plid) %>">
                    <i class="icon ion-ios-albums" aria-hidden="true"></i> <%= I18n.translate(locale, "View as playlist") %>
                </a>
            <% end %>
        </div>
    </header>

    <% if trending.empty? %>
        <p class="discovery-empty"><%= I18n.translate(locale, "trending_empty") %></p>
    <% else %>
        <div class="pure-g">
            <% trending.each do |item| %>
                <%= rendered "components/item" %>
            <% end %>
        </div>
    <% end %>
</main>

<script src="/js/trending.js?v=<%= ASSET_COMMIT %>" defer></script>
<script src="/js/watched_indicator.js?v=<%= ASSET_COMMIT %>"></script>
