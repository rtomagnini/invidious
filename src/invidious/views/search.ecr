<%
    search_privacy = preferences.search_privacy
    search_method = search_privacy ? "post" : "get"
    search_query = query.text.size > 30 ? HTML.escape(query.text[0,30].rstrip(".")) + "&hellip;" : HTML.escape(query.text)
%>

<% content_for "header" do %>
<title><%= search_privacy ? I18n.translate(locale, "Search") : search_query %> - Invidious</title>
<link rel="stylesheet" href="/css/search.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="search-results" aria-labelledby="search-results-title">
    <header class="search-results-header">
        <div class="search-results-heading">
            <h1 id="search-results-title"><%= I18n.translate(locale, "search_results_heading") %></h1>
            <% unless query.text.empty? %>
                <p dir="auto"><%= HTML.escape(query.text) %></p>
            <% end %>
        </div>

        <% if query.type.regular? %>
            <%
                type_params = query.filters.to_iv_params
                type_params.delete_all("type")
                current_type = query.filters.type.to_s.downcase
                search_types = {
                    {"all", "ion-ios-apps"},
                    {"video", "ion-ios-play"},
                    {"channel", "ion-ios-person"},
                    {"playlist", "ion-ios-albums"},
                }
            %>
            <form class="search-type-bar" aria-label="<%= HTML.escape(I18n.translate(locale, "search_filters_type_label")) %>" action="/search" method="<%= search_method %>">
                <input type="hidden" name="q" value="<%= HTML.escape(query.text) %>">
                <input type="hidden" name="region" value="<%= HTML.escape(query.region.to_s) %>">
                <% type_params.each do |name, value| %>
                    <input type="hidden" name="<%= HTML.escape(name) %>" value="<%= HTML.escape(value) %>">
                <% end %>
                <% search_types.each do |type, icon| %>
                    <button type="submit" name="type" value="<%= type %>" <%= %(aria-current="true") if current_type == type %>>
                        <i class="icon <%= icon %>" aria-hidden="true"></i>
                        <%= I18n.translate(locale, "search_type_#{type}") %>
                    </button>
                <% end %>
            </form>

            <details class="search-filter-disclosure">
                <summary>
                    <i class="icon ion-ios-options" aria-hidden="true"></i>
                    <%= I18n.translate(locale, "search_filters_title") %>
                    <% filters = query.filters %>
                    <% if !filters.date.none? || !filters.duration.none? || !filters.sort.relevance? || !filters.features.none? || filters.type.movie? || filters.type.show? %>
                        <span class="search-filters-active"><%= I18n.translate(locale, "search_filters_active") %></span>
                    <% end %>
                    <i class="icon ion-ios-arrow-down search-filter-chevron" aria-hidden="true"></i>
                </summary>
                <form class="search-filter-form" action="/search" method="<%= search_method %>">
                    <input type="hidden" name="q" value="<%= HTML.escape(query.text) %>">
                    <input type="hidden" name="region" value="<%= HTML.escape(query.region.to_s) %>">
                    <%= Invidious::Frontend::SearchFilters.generate(query.filters, locale) %>
                    <div class="search-filter-apply">
                        <button type="submit"><%= I18n.translate(locale, "search_filters_apply_button") %></button>
                    </div>
                </form>
            </details>
        <% end %>
    </header>

    <% if items.empty? %>
        <div class="search-empty">
            <h2><%= I18n.translate(locale, "search_message_no_results") %></h2>
            <p><%= I18n.translate(locale, "search_message_change_filters_or_query") %></p>
            <p><%= I18n.translate(locale, "search_message_use_another_instance", redirect_url) %></p>
        </div>
    <% else %>
        <%= rendered "components/items_paginated" %>
    <% end %>
</main>
