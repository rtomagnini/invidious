<% if user %>
    <% subscribed = subscriptions.includes?(ucid) %>
    <% subscription_action = subscribed ? "remove_subscriptions" : "create_subscription_to_channel" %>
    <form action="/subscription_ajax?action=<%= subscription_action %>&amp;c=<%= URI.encode_www_form(ucid) %>&amp;referer=<%= env.get("current_page") %>"
          method="post"
          data-subscribe-label="<%= HTML.escape(I18n.translate(locale, "Subscribe")) %>"
          data-unsubscribe-label="<%= HTML.escape(I18n.translate(locale, "Unsubscribe")) %>">
        <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
        <button type="submit" data-type="<%= subscribed ? "unsubscribe" : "subscribe" %>" id="subscribe" class="pure-button pure-button-primary">
            <b><span data-subscribe-text><%= I18n.translate(locale, subscribed ? "Unsubscribe" : "Subscribe") %></span> | <%= HTML.escape(sub_count_text) %></b>
        </button>
    </form>
    <script defer src="/js/subscribe_widget.js?v=<%= ASSET_COMMIT %>"></script>
<% else %>
    <a id="subscribe" class="pure-button pure-button-primary" href="/login?referer=<%= env.get("current_page") %>">
        <b><%= I18n.translate(locale, "Subscribe") %> | <%= HTML.escape(sub_count_text) %></b>
    </a>
<% end %>
