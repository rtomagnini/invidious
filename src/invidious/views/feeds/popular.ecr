<% content_for "header" do %>
<meta name="description" content="<%= HTML.escape(I18n.translate(locale, "An alternative front-end to YouTube")) %>">
<title><%= preferences.default_home == "Popular" ? "Invidious" : "#{I18n.translate(locale, "Popular")} - Invidious" %></title>
<link rel="stylesheet" href="/css/discovery.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="discovery-page" aria-labelledby="popular-title">
    <header class="discovery-header discovery-header-row">
        <div class="discovery-identity">
            <span class="discovery-icon" aria-hidden="true"><i class="icon ion-ios-flame"></i></span>
            <h1 id="popular-title"><%= I18n.translate(locale, "Popular") %></h1>
        </div>
        <% if videos.empty? %>
            <a class="discovery-action" href="/feed/trending">
                <i class="icon ion-ios-trending-up" aria-hidden="true"></i>
                <%= I18n.translate(locale, "Trending") %>
            </a>
        <% end %>
    </header>

    <% if !CONFIG.popular_enabled %>
        <p class="discovery-empty"><%= I18n.translate(locale, "The Popular feed has been disabled by the administrator.") %></p>
    <% elsif videos.empty? %>
        <p class="discovery-empty"><%= I18n.translate(locale, "popular_empty") %></p>
    <% else %>
        <div class="pure-g">
            <% videos.each do |item| %>
                <%= rendered "components/item" %>
            <% end %>
        </div>
    <% end %>
</main>

<script src="/js/watched_indicator.js?v=<%= ASSET_COMMIT %>"></script>
