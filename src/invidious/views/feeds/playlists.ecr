<% content_for "header" do %>
<title><%= I18n.translate(locale, "Playlists") %> - Invidious</title>
<link rel="stylesheet" href="/css/playlist-library.css?v=<%= ASSET_COMMIT %>">
<% end %>

<% library_referer = URI.encode_www_form("/feed/playlists") %>
<main class="playlist-library" aria-labelledby="playlist-library-title">
    <div class="playlist-library-heading">
        <div>
            <h1 id="playlist-library-title"><%= I18n.translate(locale, "Playlists") %></h1>
            <p><%= I18n.translate_count(locale, "generic_playlists_count", items_created.size + items_saved.size, I18n::NumberFormatting::Separator) %></p>
        </div>
        <div class="playlist-library-actions">
            <a href="/data_control?referer=<%= library_referer %>">
                <i class="icon ion-ios-swap" aria-hidden="true"></i> <%= I18n.translate(locale, "Import/export") %>
            </a>
            <a class="playlist-library-create" href="/create_playlist?referer=<%= library_referer %>">
                <i class="icon ion-md-add" aria-hidden="true"></i> <%= I18n.translate(locale, "Create playlist") %>
            </a>
        </div>
    </div>

    <% {"created" => items_created, "saved" => items_saved}.each do |group, playlists| %>
        <section class="playlist-library-section" aria-labelledby="playlists-<%= group %>">
            <h2 id="playlists-<%= group %>">
                <%= I18n.translate(locale, "playlist_library_#{group}") %>
                <span class="playlist-library-count"><%= number_with_separator(playlists.size) %></span>
            </h2>
            <% if playlists.empty? %>
                <p class="playlist-library-empty"><%= I18n.translate(locale, "playlist_library_empty_#{group}") %></p>
            <% else %>
                <ul class="playlist-library-grid">
                    <% playlists.each do |playlist| %>
                        <%= rendered "components/playlist_library_card" %>
                    <% end %>
                </ul>
            <% end %>
        </section>
    <% end %>
</main>
