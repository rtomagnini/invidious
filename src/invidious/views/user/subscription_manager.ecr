<% content_for "header" do %>
<title><%= I18n.translate(locale, "Subscription manager") %> - Invidious</title>
<% end %>

<div class="pure-g h-box">
    <div class="pure-u-1-3">
        <h3>
            <a href="/feed/subscriptions">
                <%= I18n.translate_count(locale, "generic_subscriptions_count", subscriptions.size, I18n::NumberFormatting::HtmlSpan) %>
            </a>
        </h3>
    </div>
    <div class="pure-u-1-3">
        <h3 style="text-align:center">
            <a href="/feed/history">
                <%= I18n.translate(locale, "Watch history") %>
            </a>
        </h3>
    </div>
    <div class="pure-u-1-3">
        <h3 style="text-align:right">
            <a href="/data_control?referer=<%= URI.encode_www_form(referer) %>">
                <%= I18n.translate(locale, "Import/export") %>
            </a>
        </h3>
    </div>
</div>

<% subscriptions.each do |channel| %>
    <div class="h-box">
        <div class="pure-g<% if channel.deleted %> deleted <% end %>">
            <div class="pure-u-2-5">
                <h3 style="padding-left:0.5em">
                    <a href="/channel/<%= channel.id %>"><%= HTML.escape(channel.author) %></a>
                </h3>
            </div>
            <div class="pure-u-2-5">
                <%
                    types = filters[channel.id]?
                    selected = types || (user.preferences.hide_shorts ? "vl" : "vsl")
                    options = [
                        {"videos", Invidious::Database::SubscriptionFilters::VIDEO},
                        {"shorts", Invidious::Database::SubscriptionFilters::SHORT},
                        {"live", Invidious::Database::SubscriptionFilters::LIVE},
                    ]
                    summary = if types.nil?
                        I18n.translate(locale, "subscription_filter_inherit")
                    elsif types.empty?
                        I18n.translate(locale, "subscription_filter_empty")
                    else
                        options.select { |_, code| types.includes?(code) }.map { |name, _|
                            I18n.translate(locale, "subscription_filter_#{name}")
                        }.join(", ")
                    end
                %>
                <details>
                    <summary><%= summary %></summary>
                    <form class="pure-form pure-form-stacked" method="post" action="/subscription_ajax?action=save_filter&amp;c=<%= channel.id %>">
                        <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                        <fieldset>
                            <legend><%= I18n.translate(locale, "subscription_filter_feed_types") %></legend>
                            <% options.each do |name, code| %>
                                <label>
                                    <input type="checkbox" name="filter_<%= name %>" <%= "checked" if selected.includes?(code) %>>
                                    <%= I18n.translate(locale, "subscription_filter_#{name}") %>
                                </label>
                            <% end %>
                            <button class="pure-button" type="submit" name="filter_mode" value="custom"><%= I18n.translate(locale, "subscription_filter_save") %></button>
                            <% if types %>
                                <button class="pure-button" type="submit" name="filter_mode" value="inherit"><%= I18n.translate(locale, "subscription_filter_inherit") %></button>
                            <% end %>
                        </fieldset>
                    </form>
                </details>
            </div>
            <div class="pure-u-1-5" style="text-align:right">
                <h3 style="padding-right:0.5em">
                    <form data-onsubmit="return_false" action="/subscription_ajax?action=remove_subscriptions&c=<%= channel.id %>&referer=<%= env.get("current_page") %>" method="post">
                        <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                        <input style="all:unset" type="submit" data-onclick="remove_subscription" data-ucid="<%= channel.id %>" value="<%= I18n.translate(locale, "unsubscribe") %>">
                    </form>
                </h3>
            </div>
        </div>

        <% if subscriptions[-1].author != channel.author %>
            <hr>
        <% end %>
    </div>
<% end %>
