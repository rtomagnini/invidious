<% content_for "header" do %>
<title><%= I18n.translate(locale, "playlist_edit_heading") %> · <%= HTML.escape(playlist.title) %> - Invidious</title>
<link rel="stylesheet" href="/css/playlist-pages.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="playlist-page" aria-labelledby="playlist-edit-title">
    <div class="playlist-panel playlist-editor">
        <a class="playlist-back" href="/playlist?list=<%= plid %>"><i class="icon ion-ios-arrow-back" aria-hidden="true"></i> <span dir="auto"><%= HTML.escape(playlist.title) %></span></a>
        <h1 id="playlist-edit-title"><%= I18n.translate(locale, "playlist_edit_heading") %></h1>
        <form action="/edit_playlist?list=<%= plid %>" method="post">
            <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
            <% form_title = playlist.title; form_privacy = playlist.privacy.to_s %>
            <div class="playlist-form-fields">
                <%= rendered "components/playlist_form_fields" %>
                <label for="playlist-description" class="playlist-field playlist-field-full">
                    <span><%= I18n.translate(locale, "playlist_description_label") %></span>
                    <textarea id="playlist-description" name="description" maxlength="5000" rows="4"><%= HTML.escape(playlist.description) %></textarea>
                </label>
            </div>
            <div class="playlist-actions playlist-form-actions">
                <a class="playlist-danger" href="/delete_playlist?list=<%= plid %>"><i class="icon ion-md-trash" aria-hidden="true"></i> <%= I18n.translate(locale, "generic_button_delete") %></a>
                <div class="playlist-actions">
                    <a href="/playlist?list=<%= plid %>"><%= I18n.translate(locale, "generic_button_cancel") %></a>
                    <button type="submit" class="playlist-primary"><%= I18n.translate(locale, "generic_button_save") %></button>
                </div>
            </div>
        </form>
    </div>
    <div class="playlist-items-heading">
        <h2><%= I18n.translate_count(locale, "generic_videos_count", playlist.video_count, I18n::NumberFormatting::Separator) %></h2>
        <div class="playlist-actions"><a href="/add_playlist_items?list=<%= plid %>"><i class="icon ion-md-add" aria-hidden="true"></i> <%= I18n.translate(locale, "playlist_button_add_items") %></a></div>
    </div>
    <% if items.empty? %>
        <p class="playlist-empty"><%= I18n.translate(locale, "playlist_page_empty") %></p>
    <% else %>
        <%= rendered "components/items_paginated" %>
    <% end %>
</main>
