<% content_for "header" do %>
<meta name="description" content="<%= HTML.escape(I18n.translate(locale, "An alternative front-end to YouTube")) %>">
<title>Invidious · <%= I18n.translate(locale, "search") %></title>
<link rel="stylesheet" href="/css/empty.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="search-home" aria-labelledby="search-home-title">
    <img class="search-home-mark" src="/brand-mark.svg?v=<%= ASSET_COMMIT %>" width="64" height="64" alt="">
    <h1 id="search-home-title"><%= I18n.translate(locale, "search_home_heading") %></h1>
    <div class="site-search searchbar">
        <% autofocus = true %><%= rendered "components/search_box" %>
    </div>
</main>
