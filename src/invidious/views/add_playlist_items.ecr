<% content_for "header" do %>
<title><%= I18n.translate(locale, "playlist_button_add_items") %> · <%= HTML.escape(playlist.title) %> - Invidious</title>
<link rel="stylesheet" href="/css/playlist-pages.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="playlist-page" aria-labelledby="playlist-add-title">
    <div class="playlist-panel playlist-editor">
        <a class="playlist-back" href="/playlist?list=<%= plid %>"><i class="icon ion-ios-arrow-back" aria-hidden="true"></i> <span dir="auto"><%= HTML.escape(playlist.title) %></span></a>
        <h1 id="playlist-add-title"><%= I18n.translate(locale, "playlist_button_add_items") %></h1>
        <form class="playlist-search-form" action="/add_playlist_items" method="get">
            <input type="hidden" name="list" value="<%= plid %>">
            <% query_text = query.try(&.text) || "" %>
            <% search_label = HTML.escape(I18n.translate(locale, "Search for videos")) %>
            <label class="playlist-field">
                <span class="site-visually-hidden"><%= search_label %></span>
                <input type="search" name="q" required value="<%= HTML.escape(query_text) %>" placeholder="<%= search_label %>">
            </label>
            <div class="playlist-actions">
                <button type="submit" class="playlist-primary"><i class="icon ion-ios-search" aria-hidden="true"></i> <%= I18n.translate(locale, "Search") %></button>
            </div>
        </form>
    </div>

    <% if items.empty? %>
        <p class="playlist-empty"><%= I18n.translate(locale, query_text.empty? ? "playlist_search_hint" : "search_message_no_results") %></p>
    <% else %>
        <%= rendered "components/items_paginated" %>
    <% end %>
</main>
