<% content_for "header" do %>
<title><%= I18n.translate(locale, "Create playlist") %> - Invidious</title>
<link rel="stylesheet" href="/css/playlist-pages.css?v=<%= ASSET_COMMIT %>">
<% end %>

<main class="playlist-page playlist-page-narrow" aria-labelledby="playlist-create-title">
    <div class="playlist-panel">
        <h1 id="playlist-create-title"><%= I18n.translate(locale, "Create playlist") %></h1>
        <form action="/create_playlist?referer=<%= URI.encode_www_form(referer) %>" method="post">
            <input type="hidden" name="csrf_token" value="<%= HTML.escape(csrf_token) %>">
            <% form_title = ""; form_privacy = "Public" %>
            <div class="playlist-form-fields"><%= rendered "components/playlist_form_fields" %></div>
            <div class="playlist-actions playlist-form-actions">
                <a href="<%= HTML.escape(referer) %>"><%= I18n.translate(locale, "generic_button_cancel") %></a>
                <button type="submit" class="playlist-primary" name="action" value="create_playlist"><%= I18n.translate(locale, "Create playlist") %></button>
            </div>
        </form>
    </div>
</main>
